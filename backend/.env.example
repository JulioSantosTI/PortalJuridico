# Banco de dados
DATABASE_URL="postgresql://juridico:juridico@localhost:5433/portal_juridico?schema=public"

# Auth
JWT_SECRET="troque-por-um-segredo-forte-em-producao"
JWT_EXPIRES_IN="8h"

# Servidor
PORT=3333
# Lista separada por vírgula. Para acessar o front pelo IP da máquina na rede local,
# adicione http://SEU_IP:5173 aqui também (ex: "http://localhost:5173,http://192.168.0.10:5173").
CORS_ORIGIN="http://localhost:5173"

# Storage S3-compatible (dev local usa MinIO do docker-compose)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="portal-juridico-anexos"
S3_ACCESS_KEY_ID="juridico"
S3_SECRET_ACCESS_KEY="juridico123"
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL="http://localhost:9000/portal-juridico-anexos"

# URL do frontend (usada para redirecionar de volta após o login do Google)
FRONTEND_URL="http://localhost:5173"

# Chave simétrica para criptografar tokens do Google salvos no banco (32 bytes em hex).
# Gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="troque-por-32-bytes-em-hex-gerados-aleatoriamente"

# Google Calendar (OAuth) — criar em https://console.cloud.google.com
# 1. Ativar a "Google Calendar API"
# 2. Configurar a tela de consentimento OAuth (tipo Externo, modo Testing, adicionar
#    os e-mails que vão usar a Agenda como "test users")
# 3. Criar credencial OAuth 2.0 Client ID (tipo "Web application") com Authorized
#    redirect URI = o mesmo valor de GOOGLE_REDIRECT_URI abaixo
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3333/api/calendar/oauth/callback"
