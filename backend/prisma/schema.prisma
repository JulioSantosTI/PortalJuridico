generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USUARIO
  COLABORADOR
  GESTOR
}

enum RequestStatus {
  ABERTO
  EM_ANDAMENTO
  FINALIZADO
}

enum AccessRequestStatus {
  PENDENTE
  APROVADO
  RECUSADO
}

enum InternalTicketStatus {
  ABERTO
  RESOLVIDO
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  setor        String
  loja         String
  cidade       String
  estado       String
  cargo        String?
  avatarKey    String?
  active       Boolean  @default(true)
  hasLicense   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  requestsCreated  Request[]            @relation("RequesterRequests")
  requestsAssigned Request[]            @relation("AssignedRequests")
  interactions     RequestInteraction[]
  attachments      Attachment[]
  googleAccount    GoogleAccount?
  calendarEvents   CalendarEvent[]
  reviewedRequests AccessRequest[]      @relation("ReviewedAccessRequests")
  internalTickets  InternalTicket[]
  internalTicketInteractions InternalTicketInteraction[]

  @@index([role])
  @@index([role, active])
  @@index([role, hasLicense])
}

model LicensePool {
  id            String   @id @default(uuid())
  role          Role     @unique
  totalLicenses Int
  updatedAt     DateTime @updatedAt
}

model PlatformAdmin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  internalTicketInteractions InternalTicketInteraction[]
}

model AccessRequest {
  id              String              @id @default(uuid())
  name            String
  email           String
  passwordHash    String
  setor           String
  loja            String
  cidade          String
  estado          String
  requestedRole   Role
  status          AccessRequestStatus @default(PENDENTE)
  rejectionReason String?
  reviewedById    String?
  reviewedBy      User?               @relation("ReviewedAccessRequests", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status])
  @@index([email])
}

model CalendarEvent {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  title           String
  description     String?
  startAt         DateTime
  endAt           DateTime
  reminderMinutes Int      @default(30)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, startAt])
}

model GoogleAccount {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  googleEmail     String
  accessTokenEnc  String
  refreshTokenEnc String
  expiryDate      DateTime
  scope           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model RequestType {
  id              String  @id @default(uuid())
  name            String
  slug            String  @unique
  slaBusinessDays Int
  active          Boolean @default(true)

  requests Request[]
}

model Request {
  id            String        @id @default(uuid())
  requestTypeId String
  requestType   RequestType   @relation(fields: [requestTypeId], references: [id])

  requesterId   String
  requester     User          @relation("RequesterRequests", fields: [requesterId], references: [id])
  requesterSetor String
  requesterLoja  String

  assignedToId  String?
  assignedTo    User?         @relation("AssignedRequests", fields: [assignedToId], references: [id])

  status        RequestStatus @default(ABERTO)
  dueDate       DateTime
  closedAt      DateTime?

  // Campos específicos - Advertência
  advertidoNome String?
  motivo        String?

  // Campos específicos - Revisão de Contrato
  descricaoRevisao String?

  // Reservado para campos de futuros tipos de solicitação
  detalhes      Json?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  interactions  RequestInteraction[]
  attachments   Attachment[]

  @@index([requesterSetor])
  @@index([requesterLoja])
  @@index([advertidoNome])
  @@index([status])
  @@index([createdAt])
}

model RequestInteraction {
  id             String         @id @default(uuid())
  requestId      String
  request        Request        @relation(fields: [requestId], references: [id])
  authorId       String
  author         User           @relation(fields: [authorId], references: [id])
  message        String
  statusChangeTo RequestStatus?
  createdAt      DateTime       @default(now())

  attachments    Attachment[]
}

model Attachment {
  id            String               @id @default(uuid())
  requestId     String
  request       Request              @relation(fields: [requestId], references: [id])
  interactionId String?
  interaction   RequestInteraction?  @relation(fields: [interactionId], references: [id])
  uploadedById  String
  uploadedBy    User                 @relation(fields: [uploadedById], references: [id])
  fileName      String
  storageKey    String
  mimeType      String
  sizeBytes     Int
  createdAt     DateTime             @default(now())
}

model InternalTicket {
  id         String               @id @default(uuid())
  authorId   String
  author     User                 @relation(fields: [authorId], references: [id])
  tipo       String
  mensagem   String
  status     InternalTicketStatus @default(ABERTO)
  createdAt  DateTime             @default(now())
  resolvedAt DateTime?

  interactions InternalTicketInteraction[]
  attachments  InternalTicketAttachment[]

  @@index([status])
}

model InternalTicketInteraction {
  id            String         @id @default(uuid())
  ticketId      String
  ticket        InternalTicket @relation(fields: [ticketId], references: [id])
  authorUserId  String?
  authorUser    User?          @relation(fields: [authorUserId], references: [id])
  authorAdminId String?
  authorAdmin   PlatformAdmin? @relation(fields: [authorAdminId], references: [id])
  message       String
  createdAt     DateTime       @default(now())

  attachments InternalTicketAttachment[]

  @@index([ticketId])
}

model InternalTicketAttachment {
  id            String                     @id @default(uuid())
  ticketId      String
  ticket        InternalTicket             @relation(fields: [ticketId], references: [id])
  interactionId String?
  interaction   InternalTicketInteraction? @relation(fields: [interactionId], references: [id])
  fileName      String
  storageKey    String
  mimeType      String
  sizeBytes     Int
  createdAt     DateTime                   @default(now())
}
